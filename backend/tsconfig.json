{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "./dist",          // <- compiled JS files go here
    "rootDir": "./",             // <- TS source files root
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": false       // <- still emit JS even if TS has errors
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
